# AI Lead Intelligence & Crawler Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
APP_DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./leads.db

# ==============================================================================
# AI Provider & Model Configuration
# ==============================================================================
AI_PROVIDER=gemini

# Google Gemini API Configuration
# Paste your Gemini API key below to activate AI Lead Extraction & AI Scoring:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
# Supported models: gemini-2.0-flash-lite, gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# XAH Search API (required for grounded search/chat)
XAH_API_KEY=
XAH_SEARCH_URL=https://api.xah.io/v1/search
XAH_SEARCH_MODEL=search
XAH_SEARCH_TYPE=web
XAH_MAX_RESULTS=5
XAH_COUNTRY=Vietnam
XAH_LANGUAGE=Vietnam

# Google Sheets database. Share the sheet with client_email in the service account JSON.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_LEADS_WORKSHEET=Leads
GOOGLE_SHEETS_SETTINGS_WORKSHEET=Settings

# Local Ollama Configuration (Optional alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==============================================================================
# Crawler & Rate Limit Settings
# ==============================================================================
CRAWL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=1.5
DEFAULT_RATE_LIMIT_DELAY=1.0

# Security
SECRET_KEY=ai-lead-intelligence-secure-key-2026
