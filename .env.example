# AI Lead Intelligence & Crawler Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
APP_DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./leads.db

# ==============================================================================
# AI Provider & Model Configuration (XAH / OpenAI-compatible Gateway)
# ==============================================================================
AI_PROVIDER=gemini

# Shared Gateway Base URL (Defaults to XAH Gateway)
AI_BASE_URL=https://api.xah.io/v1

# XAH Unified API Key (Used for LLM completions, extraction, scoring & search)
XAH_API_KEY=

# LLM Models
GEMINI_MODEL=levuphong2909/gemini-3.8-flash-high
OPENAI_MODEL=dungcsnd113/deepseek-v4-flash-0731

# Optional overrides if using direct Google AI Studio or OpenAI directly instead of gateway:
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# XAH Search API (official-site discovery and source-backed round-two enrichment)
XAH_SEARCH_URL=https://api.xah.io/v1/search
XAH_SEARCH_MODEL=dungcsnd113/deepseek-v4-flash-0731
XAH_SEARCH_TYPE=web
XAH_MAX_RESULTS=5
XAH_COUNTRY=Vietnam
XAH_LANGUAGE=Vietnam

# Apify LinkedIn Post Search (backend only)
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-post-search
APIFY_LINKEDIN_MAX_POSTS_PER_KEYWORD=1000
APIFY_LINKEDIN_PROFILE_SCRAPER_MODE=short
APIFY_LINKEDIN_CONTENT_TYPE=jobs
APIFY_LINKEDIN_SORT_BY=relevance
APIFY_LINKEDIN_RUN_TIMEOUT_SECONDS=9000

# Round-two Company Profile crawler
COMPANY_ENRICHMENT_ENABLED=true
COMPANY_ENRICHMENT_MODE=xah
COMPANY_PROFILE_MAX_PAGES=20
COMPANY_PROFILE_MAX_DEPTH=3
COMPANY_XAH_MAX_QUERIES=3
COMPANY_XAH_RETRY_ATTEMPTS=5

# Primary Database: SQLite local database (leads.db) is used directly on this server.
# Google Sheets is optional/disabled by default.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_LEADS_WORKSHEET=Leads

# Local Ollama Configuration (Optional alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==============================================================================
# API & Crawler Timeouts (60s)
# ==============================================================================
LLM_TIMEOUT_SECONDS=60
XAH_TIMEOUT_SECONDS=60
CRAWL_TIMEOUT_SECONDS=60
MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=1.5
DEFAULT_RATE_LIMIT_DELAY=1.0

# Optional. Recommended if TopCV blocks the Render datacenter IP.
# Format: http://user:password@host:port or socks5://host:port
TOPCV_PROXY_URL=

# Security
SECRET_KEY=ai-lead-intelligence-secure-key-2026
